{
  "name": "dsh-longtask-relay",
  "version": "1.6.3",
  "type": "module",
  "description": "Keep one long task moving across fresh sessions: truth source in workspace files, handoff carries goal and preset, delivery gated by a seal, plugin-run verify, independent review, and human sign-off.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syncaus/dsh-longtask-relay.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "long-task",
    "relay",
    "handoff",
    "context"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/client-boot.mjs && node test/hooks-render.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
