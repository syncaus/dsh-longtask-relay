{
  "name": "@local/longtask-relay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Long-task relay: keep one task moving across fresh sessions through a workspace truth source, with automatic handoff and a monitoring panel.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
